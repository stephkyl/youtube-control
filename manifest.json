{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "version": "0.5.1",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "session-youtube@local",
      "strict_min_version": "121.0"
    }
  },
  "permissions": ["storage", "*://www.youtube.com/*", "*://m.youtube.com/*"],
  "background": {
    "scripts": ["src/shared.js", "src/background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": [
        "src/shared.js",
        "src/content/core.js",
        "src/content/styles.js",
        "src/content/filter.js",
        "src/content/shorts.js",
        "src/content/video.js",
        "src/content/overlays.js",
        "src/content/pill.js",
        "src/content/main.js"
      ],
      "css": ["src/theme.css", "src/content.css"],
      "run_at": "document_start"
    }
  ],
  "browser_action": {
    "default_title": "__MSG_extName__",
    "default_popup": "src/popup.html",
    "default_icon": "icons/icon.svg"
  }
}
